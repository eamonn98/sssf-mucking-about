# SSSF environment. Pi handles provider authentication separately; the current
# roster uses opencode-go/kimi-k3 via your authenticated Pi account, so no API
# keys are required here. If you change providers, add the relevant key only if
# that provider requires one and Pi does not already have an authenticated login.

# Optional overrides
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name

